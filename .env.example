# ==============================================================
# AI-Based Weather Monitoring and Alert System Configuration
# ==============================================================

# Frontend Vite Configuration
VITE_API_BASE_URL=http://localhost:5000

# Flask Server Configuration
FLASK_APP=app.py
FLASK_ENV=development
PORT=5000
SECRET_KEY=dev-secret-key-ai-weather-2026

# Database Configuration (SQLite)
DATABASE_URL=sqlite:///weather_system.db

# Open-Meteo Cache Expiry (in seconds, default 600 = 10 minutes)
CACHE_TIMEOUT=600

# Scheduler Interval (in minutes, default 30 minutes)
SCHEDULER_INTERVAL_MINUTES=30

# Flask-Mail (SMTP Settings for High & Critical Weather Alerts)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=weather-alerts@ai-monitoring.org

# Default Alert Recipient Email (can also be saved via /api/settings)
NOTIFY_EMAIL=alerts@ai-monitoring.org
